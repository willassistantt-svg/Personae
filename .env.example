# Copie este arquivo para .env na mesma pasta do docker-compose.yml.
# Sem .env, o Compose sobe no Docker Desktop em http://localhost.

# --- Docker Desktop (HTTP, porta 80) ---
PUBLIC_URL=http://localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost,http://127.0.0.1
HTTP_PORT=80

# --- VPS, depois do domínio e do Cloudflare (HTTPS) ---
# PUBLIC_URL=https://personae.men
# COOKIE_SECURE=true
# CORS_ORIGINS=https://personae.men,https://www.personae.men
# HTTP_PORT=80

POSTGRES_PASSWORD=personae
